          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- AD généralise AP -->
        <mxCell id="g_ad_ap"
          style="endArrow=block;endFill=0;startArrow=none;html=1;
                 exitX=0.5;exitY=0;exitDx=0;exitDy=0;
                 entryX=0.5;entryY=1;entryDx=0;entryDy=0;"
          edge="1" source="a_ad" target="a_ap" parent="1">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- AR généralise AD -->
