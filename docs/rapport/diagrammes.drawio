                 exitX=0.5;exitY=0;exitDx=0;exitDy=0;
                 entryX=0.5;entryY=1;entryDx=0;entryDy=0;"
          edge="1" source="a_ar" target="a_ad" parent="1">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- AN généralise AR -->
        <mxCell id="g_an_ar"
          style="endArrow=block;endFill=0;startArrow=none;html=1;
                 exitX=0.5;exitY=0;exitDx=0;exitDy=0;
                 entryX=0.5;entryY=1;entryDx=0;entryDy=0;"
          edge="1" source="a_an" target="a_ar" parent="1">
          <mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ════════════════════════════════════════════════════
             ASSOCIATIONS Acteurs → Cas d'utilisation
             ════════════════════════════════════════════════════ -->
        <!-- VNA → Zone 1 -->
        <mxCell id="e1"  style="endArrow=none;html=1;" edge="1" source="a_vna" target="uc01" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2"  style="endArrow=none;html=1;" edge="1" source="a_vna" target="uc02" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
