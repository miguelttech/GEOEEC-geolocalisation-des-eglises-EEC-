             ════════════════════════════════════════════════════ -->
        <mxCell id="a_gs" value="GeoServer&#xa;«système»"
          style="shape=mxgraph.uml.actor;whiteSpace=wrap;html=1;align=center;
                 verticalLabelPosition=bottom;labelPosition=center;verticalAlign=top;
                 fillColor=#555555;strokeColor=#555555;"
          vertex="1" parent="1"><mxGeometry x="1030" y="2150" width="40" height="75" as="geometry" /></mxCell>

        <!-- ════════════════════════════════════════════════════
             GÉNÉRALISATIONS — triangles ouverts pointant vers parent
             Chaîne 1 : VA → VNA
             Chaîne 2 : AD → AP → (AD→AR→AN)
             ════════════════════════════════════════════════════ -->
        <!-- VA généralise VNA -->
        <mxCell id="g_va_vna"
          style="endArrow=block;endFill=0;startArrow=none;html=1;
                 exitX=0.5;exitY=0;exitDx=0;exitDy=0;
                 entryX=0.5;entryY=1;entryDx=0;entryDy=0;"
