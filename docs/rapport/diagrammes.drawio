        <mxCell id="e30" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" source="uc01" target="a_gs" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- ════════════════════════════════════════════════════
             RELATIONS <<include>> et <<extend>>
             Routage par la droite (x≈910, hors système)
             ════════════════════════════════════════════════════ -->

        <!-- UC21 <<include>> UC22 :
             "Gérer comptes" inclut toujours "Assigner rôle et scope"
             Flèche pointillée vers bas, droite des ovales -->
        <mxCell id="inc_21_22" value="«include»"
          style="dashed=1;endArrow=open;endFill=0;startArrow=none;html=1;
                 fontSize=10;fontStyle=2;edgeStyle=elbowEdgeStyle;elbow=vertical;
                 exitX=1;exitY=0.5;exitDx=0;exitDy=0;
                 entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="uc21" target="uc22" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="1583" />
              <mxPoint x="840" y="1653" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- UC08 <<include>> UC07 :
             "Calculer itinéraire" inclut "Trouver paroisse la plus proche"
             (l'endpoint PostGIS /plus-proche/ est appelé lors du calcul) -->
        <mxCell id="inc_08_07" value="«include»"
          style="dashed=1;endArrow=open;endFill=0;startArrow=none;html=1;
                 fontSize=10;fontStyle=2;
                 exitX=1;exitY=0.5;exitDx=0;exitDy=0;
                 entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="uc08" target="uc07" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="615" />
              <mxPoint x="840" y="545" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- UC11 <<extend>> UC05 :
             "Changer mot de passe" étend "S'authentifier"
             Condition : première connexion (force_password_change=True)
             Flèche longue remontant par la droite -->
        <mxCell id="ext_11_05" value="«extend»&#xa;[1ère connexion]"
          style="dashed=1;endArrow=open;endFill=0;startArrow=none;html=1;
                 fontSize=9;fontStyle=2;
                 exitX=1;exitY=0.5;exitDx=0;exitDy=0;
                 entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="uc11" target="uc05" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="920" y="825" />
              <mxPoint x="920" y="377" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- UC20 <<extend>> UC19 :
             "Télécharger gabarit" étend optionnellement "Importer données"
             (le gabarit est téléchargé en amont, avant l'import) -->
        <mxCell id="ext_20_19" value="«extend»"
          style="dashed=1;endArrow=open;endFill=0;startArrow=none;html=1;
                 fontSize=10;fontStyle=2;
                 exitX=1;exitY=0.5;exitDx=0;exitDy=0;
                 entryX=1;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="uc20" target="uc19" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="840" y="1485" />
              <mxPoint x="840" y="1415" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ════════════════════════════════════════════════════
             PRÉCONDITION AUTHENTIFICATION
             Tout acteur sauf VNA doit passer par UC05 avant d'agir.
             • VA hérite de VNA (VNA→UC05 suffit via généralisation)
             • AP (base des admins) → UC05  :  routage côté gauche x=12
               AD, AR, AN héritent de AP → UC05 transitivement
             ════════════════════════════════════════════════════ -->

        <!-- AP → UC05 : authentification obligatoire pour tous les admins -->
        <mxCell id="e_ap_uc05" value="[doit s'authentifier]"
          style="endArrow=none;html=1;dashed=1;strokeColor=#666666;
                 fontSize=8;fontStyle=2;align=center;
                 exitX=0;exitY=0.5;exitDx=0;exitDy=0;
                 entryX=0;entryY=0.5;entryDx=0;entryDy=0;"
          edge="1" source="a_ap" target="uc05" parent="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="12" y="1212" />
              <mxPoint x="12" y="377" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Note explicative (coin supérieur droit de la frontière système) -->
        <mxCell id="note_auth"
          value="⚠ Précondition (zones 2 → 7)&#xa;Toute action nécessite&#xa;S'authentifier (UC05)&#xa;sauf Visiteur Non Authentifié"
          style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;
                 fillColor=#fffde7;strokeColor=#f0a30a;
                 fontSize=9;align=left;spacingLeft=6;
                 verticalAlign=top;"
          vertex="1" parent="1">
          <mxGeometry x="910" y="52" width="210" height="72" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
