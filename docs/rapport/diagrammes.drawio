        <mxCell id="e17" style="endArrow=none;html=1;" edge="1" source="a_ap" target="uc17" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="endArrow=none;html=1;" edge="1" source="a_ap" target="uc18" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e19" style="endArrow=none;html=1;" edge="1" source="a_ap" target="uc19" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e20" style="endArrow=none;html=1;" edge="1" source="a_ap" target="uc20" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- AD → Zone 4 -->
        <mxCell id="e21" style="endArrow=none;html=1;" edge="1" source="a_ad" target="uc21" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e22" style="endArrow=none;html=1;" edge="1" source="a_ad" target="uc22" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- AR → Zone 5 -->
        <mxCell id="e23" style="endArrow=none;html=1;" edge="1" source="a_ar" target="uc23" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- AN → Zone 6 -->
        <mxCell id="e24" style="endArrow=none;html=1;" edge="1" source="a_an" target="uc24" parent="1"><mxGeometry relative="1" as="geometry" /></mxCell>
