# Copier en .env.prod, remplir avec les vraies valeurs, puis :
#   ./infra/scripts/init-letsencrypt.sh <domaine> <email>   # UNE SEULE FOIS
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# NE JAMAIS committer .env.prod dans Git

# Base de données PostgreSQL + PostGIS
DB_NAME=eec_db
DB_USER=eec_user
DB_PASSWORD=changez-ce-mot-de-passe-db-en-production

# GeoServer (≥ 20 caractères, généré aléatoirement)
GEOSERVER_ADMIN_PASSWORD=changez-ce-mot-de-passe-geoserver-long

# Domaine public réel du déploiement — utilisé par nginx (certificat TLS +
# reverse proxy, voir infra/nginx/templates/geoeec.conf.template)
DOMAIN=votre-domaine.exemple

# URLs publiques réelles, dérivées de DOMAIN (mêmes noms d'hôte, chemins
# différents selon le service — voir la configuration nginx)
NEXT_PUBLIC_API_URL=https://votre-domaine.exemple/api
NEXT_PUBLIC_GEOSERVER_URL=https://votre-domaine.exemple/geoserver

# Sauvegardes PostgreSQL (INFRA-4) — optionnel, valeurs par défaut
# raisonnables si omises (voir infra/backup/)
# BACKUP_SCHEDULE=0 3 * * *
# BACKUP_RETENTION_DAYS=14
