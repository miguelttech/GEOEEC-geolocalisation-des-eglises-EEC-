# Copier en backend/.env.prod, remplir avec les vraies valeurs, puis :
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
# NE JAMAIS committer .env.prod dans Git

# Django — DJANGO_SETTINGS_MODULE est OBLIGATOIRE (voir manage.py/wsgi.py/
# asgi.py) : aucune valeur par défaut n'est fournie pour ne jamais démarrer
# silencieusement en configuration dev si la variable est oubliée.
DJANGO_SETTINGS_MODULE=eec_core.settings.prod
SECRET_KEY=generez-une-cle-aleatoire-longue-et-unique-en-production
ALLOWED_HOSTS=votre-domaine.exemple

# Base de données PostgreSQL + PostGIS — mêmes valeurs que .env.prod (racine)
DB_NAME=eec_db
DB_USER=eec_user
DB_PASSWORD=changez-ce-mot-de-passe-db-en-production
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# GeoServer — même mot de passe que .env.prod (racine)
GEOSERVER_ADMIN_PASSWORD=changez-ce-mot-de-passe-geoserver-long
GEOSERVER_URL=http://geoserver:8080/geoserver

# E-mail (SMTP) — nécessaire pour les mots de passe générés à la création
# de compte et la réinitialisation "mot de passe oublié"
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=GÉOEEC EEC Cameroun <noreply@votre-domaine.exemple>

# URL publique du frontend — utilisée pour les liens dans les e-mails ET
# pour construire CORS_ALLOWED_ORIGINS/CSRF_TRUSTED_ORIGINS (settings/prod.py)
FRONTEND_URL=https://votre-domaine.exemple

# Dimensionnement gunicorn — voir l'en-tête de backend/docker-entrypoint.sh.
# Valeurs calibrées pour un VPS OVH VPS-2 (4 vCores, 8 Go de RAM) :
# 4 workers x 4 threads = 16 requêtes simultanées, environ 1,2 Go de RAM.
# Sur une autre machine : garder workers ~= nombre de vCores.
GUNICORN_WORKERS=4
GUNICORN_THREADS=4

# Optionnel — durée de réutilisation des connexions PostgreSQL, en secondes
# (défaut : 60, voir eec_core/settings/base.py). 0 = reconnexion à chaque requête.
# DB_CONN_MAX_AGE=60

# Journalisation (INFRA-5) — optionnel
# DJANGO_LOG_LEVEL=INFO
# ADMINS_EMAILS=admin1@exemple.com,admin2@exemple.com   # alerte e-mail sur erreur 500 si défini
