# Copier ce fichier en .env et remplir les valeurs réelles
# NE JAMAIS committer .env dans Git

# Django
# OBLIGATOIRE — aucune valeur par défaut n'est fournie par le code (voir
# manage.py/wsgi.py/asgi.py) pour ne jamais démarrer silencieusement en
# configuration dev si cette variable est oubliée en production.
# Local  : eec_core.settings.dev
# Prod   : eec_core.settings.prod
DJANGO_SETTINGS_MODULE=eec_core.settings.dev
SECRET_KEY=changez-cette-valeur-par-une-chaine-aleatoire-longue
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données PostgreSQL + PostGIS
DB_NAME=eec_db
DB_USER=eec_user
DB_PASSWORD=changez-ce-mot-de-passe-db
DB_HOST=db
DB_PORT=5432

# Redis
REDIS_URL=redis://redis:6379/0

# GeoServer (≥ 20 caractères, généré aléatoirement)
GEOSERVER_ADMIN_PASSWORD=changez-ce-mot-de-passe-geoserver-long
GEOSERVER_URL=http://geoserver:8080/geoserver
