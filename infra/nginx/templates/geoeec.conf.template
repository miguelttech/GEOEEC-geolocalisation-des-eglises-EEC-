# Reverse proxy de production — GÉOEEC (INFRA-2).
#
# Fichier "template" : traité par l'image nginx officielle au démarrage
# (envsubst automatique de ${DOMAIN} — fonctionnalité native de l'image,
# voir /docker-entrypoint.d/20-envsubst-on-templates.sh). Ne PAS éditer le
# fichier .conf généré directement, éditer ce template.
#
# Bootstrap requis avant le tout premier démarrage : voir
# infra/scripts/init-letsencrypt.sh (le certificat doit exister avant que
# nginx puisse même démarrer, à cause du bloc "listen 443 ssl" ci-dessous).

# ---------------------------------------------------------------------------
# Port 80 — défi ACME (renouvellement Let's Encrypt) + redirection HTTPS
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------------------
# Port 443 — TLS + reverse proxy vers les services internes
# ---------------------------------------------------------------------------
server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    client_max_body_size 15M;  # cohérent avec MAX_IMPORT_SIZE (backend, 10 Mo) + marge

    # --- Backend Django (API, admin, statique, médias) ---------------------
    location /api/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /admin/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /static/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
    }

    location /media/ {
        proxy_pass http://backend:8000;
        proxy_set_header Host $host;
    }

    # --- GeoServer (INFRA-7 : console d'administration bloquée) -------------
    # Ordre important : nginx retient le préfixe le PLUS SPÉCIFIQUE, donc ce
    # bloc l'emporte sur /geoserver/ ci-dessous — pas besoin d'imbrication.
    location /geoserver/web/ {
        deny all;
        return 403;
    }

    location /geoserver/ {
        proxy_pass http://geoserver:8080/geoserver/;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # --- Frontend Next.js (tout le reste) -----------------------------------
    location / {
        proxy_pass http://frontend:3004;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
    }
}
